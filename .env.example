# Copy to .env and fill in. Never commit .env.
# Leave TWELVE_DATA_API_KEY empty to run in clearly-labelled demo mode (simulated prices).

# Free key: https://twelvedata.com/pricing  (Basic plan: 8 API credits/minute, 800/day)
TWELVE_DATA_API_KEY=

# auto = Twelve Data if a key is set, otherwise demo | twelvedata | demo
MARKET_DATA_PROVIDER=auto

# How Twelve Data prices are labelled in the UI. The Basic plan lists US equities as real-time;
# set "delayed" if your plan or data is delayed. Cached prices served during rate limiting are
# always labelled "delayed".
MARKET_DATA_LABEL=live

# Seconds a quote is cached server-side (min 10). 60 keeps a few symbols within the free budget.
QUOTE_CACHE_SECONDS=60

# Client-side budget guard; match your Twelve Data plan.
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=800

# Starting cash for a new account (reset can choose a different amount, 1,000 to 10,000,000).
DEFAULT_STARTING_BALANCE=100000

# Sign-in. Required whenever HOST is not 127.0.0.1 (e.g. when deployed). 12+ characters.
# On Fly.io set it as a secret instead:  fly secrets set APP_PASSWORD='...'
APP_PASSWORD=
# Optional: sessions are signed with a random secret stored in the database if this is empty.
SESSION_SECRET=

# Server. 127.0.0.1 = this computer only. 0.0.0.0 = reachable from other devices (needs APP_PASSWORD).
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/paper_trading.db
# Postgres instead of the SQLite file (set automatically on Vercel when you connect Neon).
# Requires: pip install -r requirements.txt
DATABASE_URL=
